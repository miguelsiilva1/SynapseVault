# ==============================================================
# SynapseVault - Configuração de Variáveis de Ambiente
# ==============================================================

# Google AI Studio (Gemini Pro / Flash)
GEMINI_API_KEY="your-gemini-api-key"

# Groq Cloud (Whisper STT ultrarrápido)
GROQ_API_KEY="your-groq-api-key"

# Supabase (Base de dados e Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Cloudflare R2 (Object Storage S3-compatible)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="synapse-vault-media"
# Note: R2_PUBLIC_DOMAIN is NOT required (all I/O uses private presigned URLs and auto-purges)

# Access Control Whitelist (Strict protection for university study group)
AUTHORIZED_EMAILS="miguelangelorsilva1@gmail.com,friend1@gmail.com,friend2@university.pt"
AUTHORIZED_DOMAINS="campus.ul.pt,alunos.fc.up.pt"

